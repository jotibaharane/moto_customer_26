{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@navigation/*": ["src/navigation/*"],
      "@modules/*": ["src/modules/*"],
      "@components/*": ["src/components/*"],
      "@theme/*": ["src/theme/*"],
      "@assets/*": ["src/assets/*"],
      "@types/*": ["src/types/*"],
      "@i18n": ["src/i18n/index"],
      "@hooks/*": ["src/hooks/*"],
      "@store/*": ["src/store/*"],
      "@api/*": ["src/api/*"],
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@context/*": ["src/context/*"],
      "@slices/*": ["src/slices/*"],
      "@utils/*": ["src/utils/*"],
      "@socket/*": ["src/sockets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
